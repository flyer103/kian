#!/usr/bin/env bash
# Pre-push hook: the gates CI runs, before the push instead of after.
# Enable once per clone: git config core.hooksPath .githooks
# Default scope is derived from the pushed commits (docs-only, one crate, or
# the whole workspace when Cargo.toml/lock or a core crate changes).
# Force everything: KIAN_SELFCHECK=full git push
# Skip tests: KIAN_SELFCHECK=quick git push
# Skip the hook entirely: KIAN_SELFCHECK=off git push
set -euo pipefail

exec "$(git rev-parse --show-toplevel)/scripts/selfcheck.sh"
