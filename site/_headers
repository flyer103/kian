# Cloudflare Pages headers. GitHub Pages ignores this file.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000

/assets/*
  Cache-Control: public, max-age=604800, immutable

/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/main.js
  Cache-Control: public, max-age=3600, must-revalidate
